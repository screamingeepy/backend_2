TOKEN_KEY=PixieHollow_token_key
LOCALHOST_INSTANCE=true
SESSION_SECRET=PixieHollow_secret
API_TOKEN=PixieHollow_api
BOT_API_TOKEN=

# OTP message director
MD_HOST=127.0.0.1
MD_PORT=6666

# Outbound email (services/EmailService.js). Any SMTP provider works --
# Gmail was what was used for testing
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pixie Hollow <no-reply@example.com>

# The link to the player-facing website, used for emails
# Needs to be set to the actual URL to make sure that links work in emails
# No trailing slash, e.g. http://pixiehollow.example.com
SITE_URL=http://127.0.0.1

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
MAIL_POLL_MS=60000
# extra sender domains the ingester skips, comma separated, subdomains included
MAIL_INGEST_IGNORE_DOMAINS=

# Discord webhook for new support tickets 
# Can wire up to a Discord channel/bot to get notified of new tickets
TICKETS_WEBHOOK_URL=
